CORS_ORIGINS="http://localhost:1421,http://localhost:5173"
# Comma-separated base58 pubkeys allowed to mutate any /fims resource
ADMIN_ADDRESSES=

# Neon database (V3) — for drizzle-kit and scripts/migrate.ts
# (the worker reads it from .dev.vars / wrangler secret)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Legacy sources — only needed for scripts/migrate.ts
POSTGRES_URL=postgresql://user:password@host/dbname?sslmode=require
GOOGLE_API_KEY=
GOOGLE_SPREADSHEET_ID=
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

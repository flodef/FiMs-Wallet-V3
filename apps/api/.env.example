CORS_ORIGINS="http://localhost:1421,http://localhost:5173"
# Comma-separated base58 pubkeys allowed to mutate any /fims resource
ADMIN_ADDRESSES=

# Neon database (V3) — for drizzle-kit and scripts/migrate.ts
# (the worker reads it from .dev.vars / wrangler secret)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Solana mainnet RPC used to verify on-chain tontine donations
# (defaults to api.mainnet-beta.solana.com, which rate limits hard)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Custodial mint authority for FiMs Euro / FiMs USD (wrangler secret —
# never committed). 64-byte secret key as a JSON byte array or base58.
# The same wallet holds the EURC/USDG backing.
CUSTODIAL_KEYPAIR=
# Token-2022 mints created by scripts/create-fims-mints.ts
FIMS_EURO_MINT=
FIMS_USD_MINT=
# Backing mints (mainnet defaults: EURC / USDG — override only for devnet)
FIMS_EURO_BACKING_MINT=
FIMS_USD_BACKING_MINT=

# Yield placement — unset means backing stays in the custody wallet.
# FIMS_EURO_YIELD=jupiter-earn deposits EURC into Jupiter Earn (jlEURC).
# FIMS_USD_YIELD=kamino deposits USDG into the Kamino market below.
FIMS_EURO_YIELD=
FIMS_USD_YIELD=
FIMS_USD_YIELD_MARKET=
FIMS_USD_YIELD_RESERVE=

# Legacy sources — only needed for scripts/migrate.ts
POSTGRES_URL=postgresql://user:password@host/dbname?sslmode=require
GOOGLE_API_KEY=
GOOGLE_SPREADSHEET_ID=
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

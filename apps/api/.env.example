CORS_ORIGINS="http://localhost:1421,http://localhost:5173"
# Comma-separated base58 pubkeys allowed to mutate any /fims resource
ADMIN_ADDRESSES=

# Neon database (V3) — for drizzle-kit and scripts/migrate.ts
# (the worker reads it from .dev.vars / wrangler secret)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Solana mainnet RPC used to verify on-chain tontine donations
# (defaults to api.mainnet-beta.solana.com, which rate limits hard)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Custodial mint authority for FiMs Euro / FiMs USD (Vercel secret —
# never committed). 64-byte secret key as a JSON byte array or base58.
# The same wallet holds the EURC/USDG backing.
CUSTODIAL_KEYPAIR=
# Signer backend: "memory" (default, uses CUSTODIAL_KEYPAIR) or "gcp_kms".
# With gcp_kms the private key lives in Google Cloud KMS and never leaves
# the HSM — set the two KMS vars + a GCP service account instead of
# CUSTODIAL_KEYPAIR. Same variables exist for the strategy delegate key
# (STRATEGY_DELEGATE_SIGNER_BACKEND / _GCP_KMS_KEY_NAME / _GCP_KMS_PUBLIC_KEY).
#CUSTODIAL_SIGNER_BACKEND=gcp_kms
#CUSTODIAL_GCP_KMS_KEY_NAME=projects/…/locations/…/keyRings/…/cryptoKeys/…/cryptoKeyVersions/1
#CUSTODIAL_GCP_KMS_PUBLIC_KEY=
#GCP_SA_KEY_JSON={"type":"service_account",…} — service-account JSON (inline),
# scoped to roles/cloudkms.signerVerifier on the cryptoKey only. See
# scripts/gcp-kms-provision.sh for the full provisioning runbook.
# Token-2022 mints created by scripts/create-fims-mints.ts
FIMS_EURO_MINT=
FIMS_USD_MINT=
# Backing vault: the custody wallet keeps only a capped float; every excess
# unit of backing is swept to this Squads multisig vault PDA (2-of-3 human
# signers — the hot key can send TO it, never FROM it). Unset = feature off,
# all backing stays in the hot wallet (weaker posture).
#FIMS_BACKING_VAULT=
# Float target per product, in whole units (default 200 ≈ 200 € / 200 $).
#FIMS_EURO_FLOAT=200
#FIMS_USD_FLOAT=200
# Backing mints (mainnet defaults: EURC / USDG — override only for devnet)
FIMS_EURO_BACKING_MINT=
FIMS_USD_BACKING_MINT=

# Yield placement — unset means backing stays in the custody wallet.
# FIMS_EURO_YIELD=jupiter-earn deposits EURC into Jupiter Earn (jlEURC).
# FIMS_USD_YIELD=kamino deposits USDG into the Kamino market below.
FIMS_EURO_YIELD=
FIMS_USD_YIELD=
FIMS_USD_YIELD_MARKET=
FIMS_USD_YIELD_RESERVE=

# Legacy sources — only needed for scripts/migrate.ts
POSTGRES_URL=postgresql://user:password@host/dbname?sslmode=require
GOOGLE_API_KEY=
GOOGLE_SPREADSHEET_ID=
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Comma-separated Helius API keys (fallback on 429): "key1,key2"
HELIUS_API_KEY=

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "compatibility_date": "2025-10-24",
  "main": "src/index.ts",
  "name": "fims-wallet-api",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "preview_urls": true,
  // TODO: enable the custom domain once configured on Cloudflare
  // "routes": [
  //   {
  //     "custom_domain": true,
  //     "pattern": "api.fims.fi",
  //   },
  // ],
  "send_metrics": false,
  "vars": {
    // TODO: restrict to the deployed web origin once known
    "CORS_ORIGINS": "*"
  }
}

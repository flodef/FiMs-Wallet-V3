{
  "$schema": "node_modules/wrangler/config-schema.json",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "compatibility_date": "2025-10-17",
  "name": "fims-wallet-web",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "preview_urls": true,
  // Transition domain — will be replaced by wallet.fims.fi at V3 cutover
  "routes": [
    {
      "custom_domain": true,
      "pattern": "wallet-v3.fims.fi"
    }
  ],
  "send_metrics": false
}

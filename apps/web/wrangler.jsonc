{
  "$schema": "node_modules/wrangler/config-schema.json",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "compatibility_date": "2025-10-17",
  "name": "fims-wallet-web",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "preview_urls": true,
  // TODO: enable the custom domain once configured on Cloudflare
  // "routes": [
  //   {
  //     "custom_domain": true,
  //     "pattern": "wallet.fims.fi",
  //   },
  // ],
  "send_metrics": false
}
